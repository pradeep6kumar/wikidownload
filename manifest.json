{
  "manifest_version": 2,
  "name": "Wiki Table Downloader",
  "version": "1.0",
  "description": "Download Wikipedia tables as CSV files",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "activeTab",
    "downloads"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.wikipedia.org/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "wikitabledownloader@example.com"
    }
  }
} 